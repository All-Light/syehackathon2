# --- Agent brain. Default provider is "zen" (opencode Zen, OpenAI-compatible HTTP).
OPENCODE_API_KEY=
# Optional overrides:
# LLM_PROVIDER=zen | openai-compatible
# GRADER_MODEL=deepseek-v4-flash
# GRADER_BASE_URL=https://opencode.ai/zen/go/v1
# GRADER_API_KEY=            # only for openai-compatible
# GRADER_TIMEOUT_MS=120000

# --- Web research. Exa for search (neural, and it can read register pages
# in one call); Firecrawl for map and scrape.
EXA_API_KEY=
FIRECRAWL_API_KEY=

# --- Persistence + share links. SUPABASE_API_KEY is the sb_secret_... key:
# server-only, bypasses RLS. Never expose it to the browser.
SUPABASE_API_KEY=
SUPABASE_URL=
SUPABASE_PROJECT_ID=

# --- Payments (traction: take real money during the hackathon).
STRIPE_SECRET_KEY=

# --- Voice, if we keep an ElevenLabs surface (prize category).
ELEVENLABS_API_KEY=

# --- Selling. Unset means the buy buttons are disabled and the checkout route
# refuses. Set to 1 and redeploy to open sales (Next inlines NEXT_PUBLIC_* at
# build time, so it takes a deploy — turning sales on should be deliberate).
NEXT_PUBLIC_KOP_AKTIV=
